{
  "format_version": "1.8",
  "name": "git_log",
  "version": "0.3.0",
  "description": "Show recent commits with bounded output; optionally filter by revision and paths.",
  "requirements": {
    "tool": "pip",
    "format": "requirements.txt",
    "content": "twylt==1.0.0\npydantic>=2,<3\n"
  },
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "timeout": {
        "default": 120,
        "description": "Maximum Git runtime in seconds.",
        "maximum": 3600,
        "minimum": 1,
        "title": "Timeout",
        "type": "integer"
      },
      "repo": {
        "description": "Virtual path to a working-copy root inside TWYLT_WORKSPACE_ROOT.",
        "minLength": 1,
        "title": "Repo",
        "type": "string"
      },
      "limit": {
        "default": 20,
        "description": "Maximum number of commits returned.",
        "maximum": 1000,
        "minimum": 1,
        "title": "Limit",
        "type": "integer"
      },
      "skip": {
        "default": 0,
        "description": "Number of matching commits to skip for pagination.",
        "minimum": 0,
        "title": "Skip",
        "type": "integer"
      },
      "revision": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Single starting revision, e.g. HEAD, main or a commit hash; defaults to HEAD.",
        "title": "Revision"
      },
      "paths": {
        "description": "Optional literal relative paths whose history is shown.",
        "items": {
          "type": "string"
        },
        "title": "Paths",
        "type": "array"
      },
      "oneline": {
        "default": false,
        "description": "Return full commit hash and subject only; otherwise full author/committer metadata and message.",
        "title": "Oneline",
        "type": "boolean"
      }
    },
    "required": [
      "repo"
    ],
    "title": "InputTWYLTStrict",
    "type": "object",
    "$id": "git_log.input",
    "x-schema-version": "2.0.0"
  },
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "ok": {
        "description": "Whether the operation succeeded; always inspect this field.",
        "title": "Ok",
        "type": "boolean"
      },
      "returncode": {
        "description": "Git exit status; 124 for timeout.",
        "title": "Returncode",
        "type": "integer"
      },
      "stdout": {
        "default": "",
        "description": "Git standard output, or diff text.",
        "title": "Stdout",
        "type": "string"
      },
      "stderr": {
        "default": "",
        "description": "Git diagnostics.",
        "title": "Stderr",
        "type": "string"
      },
      "timed_out": {
        "default": false,
        "title": "Timed Out",
        "type": "boolean"
      },
      "paths": {
        "description": "Files written by put.",
        "items": {
          "type": "string"
        },
        "title": "Paths",
        "type": "array"
      }
    },
    "required": [
      "ok",
      "returncode"
    ],
    "title": "ResultTWYLTStrict",
    "type": "object",
    "$id": "git.result",
    "x-schema-version": "1.0.0"
  },
  "few_shots": [
    {
      "input": {
        "repo": "/work/project",
        "limit": 10,
        "oneline": true
      },
      "output": {
        "ok": true,
        "returncode": 0,
        "stdout": "0123456789abcdef0123456789abcdef01234567 Add hello example\n",
        "stderr": "",
        "timed_out": false,
        "paths": []
      }
    }
  ]
}
