{
  "format_version": "1.8",
  "name": "git_commit",
  "version": "0.4.0",
  "description": "Commit the current index with a message; does not implicitly add files.",
  "requirements": {
    "tool": "pip",
    "format": "requirements.txt",
    "content": "twylt>=1.1.1,<2\npydantic>=2,<3\n"
  },
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "timeout": {
        "default": 120,
        "description": "Maximum Git runtime in seconds.",
        "maximum": 3600,
        "minimum": 1,
        "title": "Timeout",
        "type": "integer"
      },
      "repo": {
        "description": "Virtual path to a working-copy root inside TWYLT_WORKSPACE_ROOT.",
        "minLength": 1,
        "title": "Repo",
        "type": "string"
      },
      "message": {
        "description": "Commit message; configured Git author identity is used.",
        "minLength": 1,
        "title": "Message",
        "type": "string"
      }
    },
    "required": [
      "repo",
      "message"
    ],
    "title": "InputTWYLTStrict",
    "type": "object",
    "$id": "git_commit.input",
    "x-schema-version": "2.0.0"
  },
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "ok": {
        "description": "Whether the operation succeeded; always inspect this field.",
        "title": "Ok",
        "type": "boolean"
      },
      "returncode": {
        "description": "Git exit status; 124 for timeout.",
        "title": "Returncode",
        "type": "integer"
      },
      "stdout": {
        "default": "",
        "description": "Git standard output, or diff text.",
        "title": "Stdout",
        "type": "string"
      },
      "stderr": {
        "default": "",
        "description": "Git diagnostics.",
        "title": "Stderr",
        "type": "string"
      },
      "timed_out": {
        "default": false,
        "title": "Timed Out",
        "type": "boolean"
      },
      "paths": {
        "description": "Files written by put.",
        "items": {
          "type": "string"
        },
        "title": "Paths",
        "type": "array"
      }
    },
    "required": [
      "ok",
      "returncode"
    ],
    "title": "ResultTWYLTStrict",
    "type": "object",
    "$id": "git.result",
    "x-schema-version": "1.0.0"
  },
  "few_shots": [
    {
      "input": {
        "repo": "/work/project",
        "message": "Add hello example"
      },
      "output": {
        "ok": true,
        "returncode": 0,
        "stdout": "",
        "stderr": "",
        "timed_out": false,
        "paths": []
      }
    }
  ]
}
